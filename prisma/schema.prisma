generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Quest {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Request {
  id                String   @id @default(uuid())
  title             String
  status            String
  fields            Json
  notes             String?
  summary           String?
  requesterAgreed   Boolean  @default(false)
  receptionistAgreed Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
