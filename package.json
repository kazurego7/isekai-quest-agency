{
  "name": "isekai-quest-agency",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:integration": "node --test tests/quest-flow.test.mjs",
    "test:http": "node scripts/test-http.mjs",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/prisma.mjs db push",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:local": "pwsh -NoProfile -File scripts/local-db.ps1",
    "db:local:stop": "pwsh -NoProfile -File scripts/local-db.ps1 -Stop",
    "db:local:staff": "node scripts/create-local-staff.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.28",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
